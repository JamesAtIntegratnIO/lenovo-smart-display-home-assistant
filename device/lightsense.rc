# Start the ambient light reporter once Android has booted. Same route as volkeys.rc:
# init -> shell -> su, with the inet group (3003) for its webhook calls.
service lightsense /system/bin/sh -c "exec /system/xbin/su 0,0,3003 /system/bin/sh /system/bin/lightsense.sh"
    class late_start
    user root
    group root
    seclabel u:r:shell:s0
    disabled

on property:sys.boot_completed=1
    start lightsense
